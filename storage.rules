rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event photos - only authenticated admins can upload
    match /events/{eventId}/photos/{photoId} {
      allow read: if true; // Public read for sharing
      allow write: if request.auth != null; // Only authenticated users
    }
    
    // Client selfies - anyone can upload (temporary)
    match /events/{eventId}/selfies/{selfieId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events - only authenticated admins can write
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Photos subcollection
      match /photos/{photoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Faces subcollection
      match /faces/{faceId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
